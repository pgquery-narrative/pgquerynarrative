# Copy to deploy/docker/.env.production and fill real values.
# docker compose -f deploy/docker/docker-compose.yml --env-file deploy/docker/.env.production up -d --build
#
# APP_ENV=production (set in compose) enables StrictMode — placeholders and
# weak secrets are rejected at process start.
#
# Generate API key hash:
#   printf '%s' "$API_KEY" | shasum -a 256 | awk '{print $1}'

POSTGRES_USER=pg_admin_user
POSTGRES_PASSWORD=replace-with-strong-postgres-password-16plus
POSTGRES_DB=pgquerynarrative

DATABASE_USER=pgquerynarrative_app
DATABASE_PASSWORD=replace-with-strong-app-password-16plus
DATABASE_READONLY_USER=pgquerynarrative_readonly
DATABASE_READONLY_PASSWORD=replace-with-strong-readonly-password-16plus
DATABASE_SSL_MODE=require
# Curated analytics schema only — never app, public, or OLTP catalogs.
DATABASE_ALLOWED_SCHEMAS=analytics

SECURITY_API_KEY_HASH=replace-with-sha256-hex-of-api-key
SECURITY_SESSION_SECRET=replace-with-random-session-secret-32plus-chars
SECURITY_DATA_ENCRYPTION_KEY=replace-with-random-encryption-key-32plus-chars
SECURITY_RATE_LIMIT_RPM=120

# Optional: corporate OIDC (recommended for browser pilot). Wire via compose
# overrides or a follow-on env file — see docs/ops/PRODUCTION.md § OIDC.
# SECURITY_OIDC_ISSUER=https://idp.example.com
# SECURITY_OIDC_CLIENT_ID=
# SECURITY_OIDC_CLIENT_SECRET=
# SECURITY_OIDC_REDIRECT_URL=https://pgquerynarrative.example.com/auth/callback

# Schedules stay off in compose (SCHEDULE_RUNNER_ENABLED=false). To enable later:
# SCHEDULE_RUNNER_ENABLED=true
# SCHEDULE_DURABLE_LEASES=true
# SECURITY_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# SECURITY_WEBHOOK_SIGNING_SECRET=replace-with-random-signing-secret-32plus
