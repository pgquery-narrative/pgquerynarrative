# Copy to .env in this directory (gitignored). Docker Compose reads .env for ${VAR} substitution.
# Then: docker compose up -d --build app

# =============================================================================
# FREE + STRONG (best for testing Ask / NL → SQL / narratives)
# =============================================================================
# Both are mainstream APIs with free tiers; you only add a key (no card on free signup flows as of writing—confirm on their sites).

# --- Option A (recommended): Groq — Meta Llama 3.3 70B, very fast inference ---
# Free API key: https://console.groq.com/keys
# Model list: https://console.groq.com/docs/models
#
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_your_key_here
# LLM_BASE_URL=

# --- Option B: Google Gemini — Gemini 2.0 Flash (good quality, generous free tier) ---
# Free API key: https://aistudio.google.com/apikey
#
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your_key_here
# LLM_BASE_URL=

# =============================================================================
# FREE + LOCAL (no API key; runs on your machine)
# =============================================================================
# Install https://ollama.com then: ollama serve && ollama pull llama3.2
# App in Docker talks to host Ollama via host.docker.internal.
# For Groq/Gemini instead: comment out the four LLM_* lines in this section and
# uncomment one Option A/B block above (only one provider active at a time).

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://host.docker.internal:11434
# LLM_API_KEY=

# Optional similar-query / RAG (same Ollama): ollama pull nomic-embed-text
# EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# Paid (omit unless you use them)
# =============================================================================
# OpenAI: LLM_PROVIDER=openai  LLM_MODEL=gpt-4o-mini  LLM_API_KEY=sk-...
# Claude:  LLM_PROVIDER=claude  LLM_MODEL=claude-sonnet-4-20250514  LLM_API_KEY=sk-ant-...
