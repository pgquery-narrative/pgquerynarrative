---
import Logo from "./Logo.astro";
import { site } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo variant="mark" height={28} />
      <p>{site.tagline}</p>
    </div>

    <div class="footer-links">
      <div>
        <h2>Project</h2>
        <ul>
          <li><a href={site.githubUrl} target="_blank" rel="noopener">GitHub</a></li>
          <li><a href={site.issuesUrl} target="_blank" rel="noopener">Issues</a></li>
          <li><a href={site.releasesUrl} target="_blank" rel="noopener">Releases</a></li>
          <li><a href={site.licenseUrl} target="_blank" rel="noopener">License (MIT)</a></li>
        </ul>
      </div>
      <div>
        <h2>Learn</h2>
        <ul>
          <li><a href={site.docsUrl} target="_blank" rel="noopener">Documentation</a></li>
          <li><a href="/get-started">Get started</a></li>
          <li><a href="/demo">Demo</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} PgQueryNarrative. MIT licensed.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 96px;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    justify-content: space-between;
    padding-block: 48px 32px;
  }

  .footer-brand {
    max-width: 320px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-brand p {
    color: var(--text-dim);
    font-size: 0.9375rem;
  }

  .footer-links {
    display: flex;
    gap: 64px;
  }

  .footer-links h2 {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-faint);
    margin-bottom: 12px;
  }

  .footer-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-links a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-block: 20px;
  }

  .footer-bottom p {
    color: var(--text-faint);
    font-size: 0.8125rem;
    margin: 0;
  }

  @media (max-width: 480px) {
    .footer-links {
      gap: 32px;
    }
  }
</style>
