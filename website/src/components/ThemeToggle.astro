---
// Accessible theme toggle: a real <button>, labeled state, keyboard
// operable by default. Persists an explicit choice; "system" is the
// unset state (no data-theme attribute, media query decides).
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  aria-pressed="false"
  class="theme-toggle"
>
  <svg
    class="icon-sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <svg
    class="icon-moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <span class="visually-hidden">Toggle color theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-dim);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--text-faint);
  }

  .icon-moon {
    display: none;
  }

  :root[data-theme="dark"] .icon-sun {
    display: none;
  }

  :root[data-theme="dark"] .icon-moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .icon-sun {
      display: none;
    }

    :root:not([data-theme="light"]) .icon-moon {
      display: block;
    }
  }
</style>

<script>
  const STORAGE_KEY = "pgquerynarrative-theme";
  const button = document.getElementById("theme-toggle");

  function currentlyDark(): boolean {
    const explicit = document.documentElement.getAttribute("data-theme");
    if (explicit === "dark") return true;
    if (explicit === "light") return false;
    return window.matchMedia("(prefers-color-scheme: dark)").matches;
  }

  function syncAria() {
    button?.setAttribute("aria-pressed", String(currentlyDark()));
  }

  syncAria();

  button?.addEventListener("click", () => {
    const next = currentlyDark() ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch (e) {
      /* ignore - theme just won't persist across reloads */
    }
    syncAria();
  });
</script>
