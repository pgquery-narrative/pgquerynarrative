---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const isProd = import.meta.env.PROD;
const allPosts = await getCollection("blog", ({ data }) => !isProd || !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function readingTime(body: string | undefined): number {
  const words = (body ?? "").trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
}
---

<BaseLayout title="Blogs" description="Engineering notes from the PgQueryNarrative project.">
  <section class="section">
    <div class="container narrow">
      <h1>Blogs</h1>

      {
        posts.length === 0 ? (
          <p class="empty">No posts yet.</p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}`} class="post-link">
                  <div class="post-list-header">
                    <h2>{post.data.title}</h2>
                    {post.data.draft && <span class="draft-badge">Draft</span>}
                  </div>
                  <p class="post-description">{post.data.description}</p>
                  <div class="post-meta">
                    <time datetime={post.data.date.toISOString()}>
                      {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                    </time>
                    <span aria-hidden="true">&middot;</span>
                    <span>{readingTime(post.body)} min read</span>
                    {post.data.tags.length > 0 && <span aria-hidden="true">&middot;</span>}
                    {post.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: 72px;
  }

  .narrow {
    max-width: 720px;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .lede {
    margin-top: 16px;
    color: var(--text-dim);
    font-size: 1.0625rem;
  }

  .empty {
    margin-top: 40px;
    color: var(--text-faint);
  }

  .post-list {
    list-style: none;
    margin: 44px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .post-link {
    display: block;
    padding-block: 24px;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }

  .post-list li:last-child .post-link {
    border-bottom: 1px solid var(--border);
  }

  .post-list-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .post-list-header h2 {
    font-size: 1.1875rem;
    color: var(--text);
  }

  .post-link:hover h2 {
    color: var(--link);
  }

  .draft-badge {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-faint);
    border: 1px solid var(--border);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .post-description {
    margin-top: 8px;
    color: var(--text-dim);
    font-size: 0.9375rem;
  }

  .post-meta {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    color: var(--text-faint);
    font-size: 0.8125rem;
  }

  .tag {
    font-family: "JetBrains Mono", monospace;
  }
</style>
