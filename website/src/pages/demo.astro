---
import BaseLayout from "../layouts/BaseLayout.astro";
import DemoVideo from "../components/DemoVideo.astro";
import { site } from "../config/site";

const steps = [
  "Start with a problematic PostgreSQL query",
  "Inspect the execution plan and its findings",
  "Evaluate a candidate rewrite or index",
  "Compare the original and candidate plans, measured with EXPLAIN (ANALYZE)",
  "Verify the candidate returns the same rows",
  "Produce an investigation report citing the evidence",
];
---

<BaseLayout
  title="Demo"
  description="Watch PgQueryNarrative investigate a slow PostgreSQL query, from execution plan to verified report."
>
  <section class="section demo-hero">
    <div class="container">
      <h1>Demo</h1>
      <p class="lede">
        A walkthrough of one investigation, start to finish: a slow query, its execution plan, a candidate fix,
        a measured comparison, and a verified report.
      </p>
    </div>
  </section>

  <section class="section demo-player-section">
    <div class="container">
      <div class="demo-grid">
        {
          site.demoVideos.map((v) => (
            <div class="demo-item">
              <DemoVideo videoId={v.videoId} title={v.title} />
              <p class="demo-caption">{v.caption}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <h2 class="section-title">What happens in the walkthrough</h2>
      <ol class="steps">
        {steps.map((step) => <li>{step}</li>)}
      </ol>
      <p class="steps-note">Each step is a real feature in the current codebase, not a planned one.</p>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-final">
      <h2>Try it yourself</h2>
      <p>The guided demo runs locally with Docker.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={site.githubUrl} target="_blank" rel="noopener" data-analytics="github_click">
          View on GitHub
        </a>
        <a class="btn btn-secondary" href="/get-started" data-analytics="get_started_click">Get started</a>
        <a class="btn btn-ghost" href={site.docsUrl} target="_blank" rel="noopener" data-analytics="docs_click">
          Read docs
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .demo-hero {
    padding-block: 64px 32px;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .lede {
    margin-top: 16px;
    font-size: 1.125rem;
    color: var(--text-dim);
    max-width: 60ch;
  }

  .demo-player-section {
    padding-top: 0;
    padding-bottom: 56px;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 28px;
  }

  .demo-caption {
    margin-top: 12px;
    color: var(--text-dim);
    font-size: 0.9375rem;
  }

  .section-muted {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding-block: 64px;
  }

  .section-title {
    font-size: 1.5rem;
  }

  .steps {
    margin: 32px 0 0;
    padding-left: 0;
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 640px;
  }

  .steps li {
    counter-increment: step;
    display: flex;
    gap: 16px;
    font-size: 1rem;
    color: var(--text);
  }

  .steps li::before {
    content: counter(step);
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .steps-note {
    margin-top: 24px;
    color: var(--text-faint);
    font-size: 0.875rem;
  }

  .cta-section {
    text-align: center;
    padding-block: 72px;
  }

  .cta-final {
    max-width: 560px;
    margin-inline: auto;
  }

  .cta-final p {
    margin-top: 12px;
    color: var(--text-dim);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 28px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 11px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--text);
    color: var(--bg);
  }

  .btn-secondary {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .btn-ghost {
    border: 1px solid var(--border);
    color: var(--text);
  }
</style>
