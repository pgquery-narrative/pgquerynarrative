---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import { site } from "../config/site";
import { Image } from "astro:assets";
import homeShot from "../../public/screenshots/home.png";
import investigateShot from "../../public/screenshots/investigate.png";

const workflow = [
  { label: "Slow query", detail: "Pasted directly, or pulled from pg_stat_statements" },
  { label: "Execution-plan findings", detail: "EXPLAIN evidence: seq scans, spills, partition pruning defeated" },
  { label: "Candidate rewrite or index", detail: "Proposed from the query's own parse tree, not a language model" },
  { label: "Before / after comparison", detail: "Both plans run through EXPLAIN (ANALYZE), measured, not estimated" },
  { label: "Result verification", detail: "Checked that both queries return the same rows" },
  { label: "Engineering report", detail: "A deterministic template citing the evidence above" },
];

const capabilities = [
  {
    title: "Execution-plan findings",
    body: "Reads EXPLAIN output and flags concrete plan problems: sequential scans, spills to disk, partition pruning defeated by a wrapped column.",
  },
  {
    title: "Rewrite candidates",
    body: "Proposes bounded SQL rewrites, such as unwrapping DATE_TRUNC on a filtered column, from the query's own AST when one applies. Not every query gets one.",
  },
  {
    title: "Index candidates",
    body: "Surfaces index DDL for review. Cost is projected through HypoPG when installed, otherwise labeled as an unverified heuristic. Nothing is applied automatically.",
  },
  {
    title: "Measured comparison",
    body: "Runs EXPLAIN (ANALYZE) on both the original and candidate query and reports real execution time and plan shape, not planner cost alone.",
  },
  {
    title: "Result verification",
    body: "Confirms the candidate returns the same rows as the original, by full checksum or a bounded sample, and says which one happened.",
  },
  {
    title: "Investigation report",
    body: "Packages the findings, candidate, comparison, and verification status into a report generated from a deterministic template.",
  },
];

const evidence = [
  {
    term: "Proposed",
    detail: "A candidate rewrite or index exists. It has not been run.",
  },
  {
    term: "Estimated",
    detail: "A planner cost, or a HypoPG projection when the extension is installed. A cost, not a time.",
  },
  {
    term: "Measured",
    detail: "EXPLAIN (ANALYZE) actually ran both queries. Real execution time and plan shape.",
  },
  {
    term: "Verified",
    detail: "The candidate's result rows were checked against the original: a full checksum match, or an explicit bounded sample.",
  },
];

// Real output from one run of this repository's own demo dataset (`make demo`,
// scenario "slow-dashboard"), captured through the running API while writing
// this page. Not a benchmark suite average — one before/after run of one
// query. Every caveat here is the product's own output, not marketing copy
// written around the numbers.
const example = {
  before: `SELECT product_category, SUM(total_amount) AS revenue
FROM demo.sales
WHERE DATE_TRUNC('month', date) = DATE '2026-08-01'
GROUP BY product_category
ORDER BY revenue DESC`,
  after: `SELECT product_category, sum(total_amount) AS revenue
FROM demo.sales
WHERE date >= '2026-08-01'::date AND date < '2026-09-01'::date
GROUP BY product_category
ORDER BY revenue DESC`,
  finding:
    "Sequential scan across 50 partitions — DATE_TRUNC('month', date) wraps the partition key, so PostgreSQL can't prune and has to scan every partition.",
  rationale:
    "Unwrap DATE_TRUNC('month') equality to a sargable range predicate so PostgreSQL can prune partitions and use indexes on the column.",
  metrics: [
    {
      label: "Execution time (median)",
      before: "47ms (3 runs, 26ms–60ms)",
      after: "5ms (3 runs, 5ms–6ms)",
      change: "−88.2%",
      caveat: "Median of 3 runs each; observed spread up to 35ms, smaller than the 41ms difference between medians.",
    },
    {
      label: "Planner cost (estimate)",
      before: "8.5k",
      after: "841.4",
      change: "−90.1%",
      caveat: "Arbitrary units, not a time and not a speed multiple. Execution time above is the actual measurement.",
    },
    {
      label: "Partitions scanned",
      before: "50",
      after: "1",
      change: "50 → 1",
      caveat: null,
    },
  ],
  verification: "VerifiedEqual — 5 rows, matched by an order-independent checksum over every row.",
};

const comparison = [
  {
    row: "Finds plan problems",
    pgqn: "Parses EXPLAIN output for seq scans, spills, and defeated pruning",
    manual: "Whatever the reader notices",
    ai: "Whatever the prompt surfaces",
  },
  {
    row: "Proposes a fix",
    pgqn: "From the query's own parse tree, against a fixed, auditable rule set",
    manual: "The engineer writes it",
    ai: "A language model generates SQL",
  },
  {
    row: "Before/after comparison",
    pgqn: "EXPLAIN (ANALYZE) run on both sides, reported as a labeled metric table",
    manual: "Only if someone remembers to run it",
    ai: "Rarely run automatically",
  },
  {
    row: "Result verification",
    pgqn: "States VerifiedEqual, SampleMatch, Different, or Unverified — never silent",
    manual: "Manual, easy to skip",
    ai: "Usually not checked at all",
  },
  {
    row: "Applies the change",
    pgqn: "Never — a person decides",
    manual: "The engineer applies it",
    ai: "Varies; some tools do",
  },
];

// Verified against internal/service/ask.go, internal/story/generator.go,
// and docs/integrations/llm.md. An LLM is optional and scoped to exactly
// these three features; everything in "What it actually does" above runs
// without one.
const aiUses = [
  {
    title: "Ask",
    body: "Natural language to SQL to a narrative report, in one step. Requires an LLM.",
  },
  {
    title: "Report narrative",
    body: "The prose in a Workbench report (headline, takeaways, drivers). Falls back to a deterministic, metrics-only narrative if the call fails or its output can't be trusted.",
  },
  {
    title: "Plain-English SQL explanation",
    body: "One or two sentences describing what a query does. Requires an LLM.",
  },
];
---

<BaseLayout title={site.name}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Open source &middot; PostgreSQL</p>
        <h1>Investigate slow PostgreSQL queries with evidence</h1>
        <p class="lede">
          Understand the execution plan, evaluate a candidate rewrite or index, compare before and after, and
          verify what actually changed before anyone touches production SQL.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={site.githubUrl} target="_blank" rel="noopener" data-analytics="github_click">
            View on GitHub
          </a>
          <a class="btn btn-secondary" href="/demo" data-analytics="watch_demo">Watch demo</a>
          <a class="btn btn-ghost" href={site.docsUrl} target="_blank" rel="noopener" data-analytics="docs_click">
            Read docs
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-mark" aria-hidden="true">
          <div class="hero-mark-icon">
            <Logo variant="mark" height={280} />
          </div>
          <svg class="hero-elephant-icon" viewBox="0 0 120 120" width="92" height="92">
            <ellipse class="elephant-body" cx="25" cy="55" rx="22" ry="28" />
            <ellipse class="elephant-body" cx="95" cy="55" rx="22" ry="28" />
            <circle class="elephant-body" cx="60" cy="50" r="34" />
            <path class="elephant-body" d="M52,78 C50,90 52,102 60,110 C68,102 70,90 68,78 Z" />
            <circle class="elephant-eye" cx="48" cy="45" r="4" />
            <circle class="elephant-eye" cx="72" cy="45" r="4" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section id="product" class="section">
    <div class="container">
      <h2 class="section-title">Walk through a real investigation</h2>
      <p class="section-lede">
        Six steps, shown with output from one actual run against this repository's own demo dataset
        (<code>make demo</code>, scenario "slow-dashboard"), captured through the running API while writing this
        page. One before/after run of one query, not a benchmark suite average.
      </p>

      <div class="stepper">
        <input type="radio" name="stepper" id="tab-1" class="stepper-radio" checked />
        <input type="radio" name="stepper" id="tab-2" class="stepper-radio" />
        <input type="radio" name="stepper" id="tab-3" class="stepper-radio" />
        <input type="radio" name="stepper" id="tab-4" class="stepper-radio" />
        <input type="radio" name="stepper" id="tab-5" class="stepper-radio" />
        <input type="radio" name="stepper" id="tab-6" class="stepper-radio" />

        <div class="stepper-tabs">
          {
            workflow.map((step, i) => (
              <label for={`tab-${i + 1}`} class="stepper-tab">
                <span class="stepper-index">{i + 1}</span>
                {step.label}
              </label>
            ))
          }
        </div>

        <div class="stepper-panel" id="panel-1">
          <p class="stepper-detail">{workflow[0].detail}</p>
          <div class="example-sql">
            <p class="example-sql-label">Query as received</p>
            <pre><code>{example.before}</code></pre>
          </div>
        </div>

        <div class="stepper-panel" id="panel-2">
          <p class="stepper-detail">{workflow[1].detail}</p>
          <p class="finding-callout">{example.finding}</p>
        </div>

        <div class="stepper-panel" id="panel-3">
          <p class="stepper-detail">{workflow[2].detail}</p>
          <div class="example-sql">
            <p class="example-sql-label">Proposed rewrite</p>
            <pre><code>{example.after}</code></pre>
            <p class="example-note">{example.rationale}</p>
          </div>
        </div>

        <div class="stepper-panel" id="panel-4">
          <p class="stepper-detail">{workflow[3].detail}</p>
          <table class="metrics-table">
            <thead>
              <tr>
                <th scope="col">Evidence</th>
                <th scope="col">Before</th>
                <th scope="col">After</th>
                <th scope="col">Change</th>
              </tr>
            </thead>
            <tbody>
              {
                example.metrics.map((m) => (
                  <tr>
                    <th scope="row">
                      {m.label}
                      {m.caveat && <span class="caveat">{m.caveat}</span>}
                    </th>
                    <td>{m.before}</td>
                    <td>{m.after}</td>
                    <td class="change">{m.change}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="stepper-panel" id="panel-5">
          <p class="stepper-detail">{workflow[4].detail}</p>
          <p class="verification-badge">
            <span class="verification-dot" aria-hidden="true"></span>
            {example.verification}
          </p>
        </div>

        <div class="stepper-panel" id="panel-6">
          <p class="stepper-detail">{workflow[5].detail}</p>
          <p class="report-note">
            A deterministic template built from the plan findings, the candidate SQL, the before/after metrics,
            and the equivalence status above. No LLM writes it, and nothing here is applied to a database
            automatically; the report is what a reviewer reads before deciding to run the DDL or ship the
            rewritten query.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <h2 class="section-title">What it actually does</h2>
      <div class="card-grid">
        {
          capabilities.map((cap) => (
            <div class="card">
              <h3>{cap.title}</h3>
              <p>{cap.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Estimate is not measurement. Proposal is not verified improvement.</h2>
      <p class="section-lede">
        A candidate rewrite existing is not evidence that it is faster, and a faster measured run is not evidence
        that it returns the same rows. PgQueryNarrative keeps these four states distinct instead of collapsing
        them into a single confidence score.
      </p>
      <dl class="evidence-grid">
        {
          evidence.map((e) => (
            <div class="evidence-item">
              <dt>{e.term}</dt>
              <dd>{e.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Compared to reading EXPLAIN by hand, or an AI SQL assistant</h2>
      <p class="section-lede">Capability, not a speed claim. None of this is measured against a competing tool.</p>
      <div class="compare-table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col">PgQueryNarrative</th>
              <th scope="col">Manual EXPLAIN reading</th>
              <th scope="col">Generic AI SQL assistant</th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((row) => (
                <tr>
                  <th scope="row">{row.row}</th>
                  <td>{row.pgqn}</td>
                  <td>{row.manual}</td>
                  <td>{row.ai}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <h2 class="section-title">Where AI fits</h2>
      <p class="section-lede">
        An LLM is optional and scoped to three features. It plays no part in plan findings, the rewrite
        engine, index candidates, plan comparison, or result verification, which are the "compared to"
        table above and the worked example further up this page.
      </p>
      <div class="card-grid">
        {
          aiUses.map((u) => (
            <div class="card">
              <h3>{u.title}</h3>
              <p>{u.body}</p>
            </div>
          ))
        }
      </div>
      <p class="ai-scope-note">
        Bring your own provider: local Ollama by default, or an opt-in cloud provider (Claude, OpenAI,
        Gemini, Groq) gated behind an explicit data-egress flag, with PII redaction and a token/cost
        budget. See <a href={site.docsUrl + "integrations/llm/"} target="_blank" rel="noopener">LLM providers</a> in
        the docs.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">UI Preview</h2>
      <div class="shot-grid">
        <figure>
          <Image src={homeShot} alt="PgQueryNarrative home screen, showing workload evidence pulled from a connected PostgreSQL database" width={1440} />
          <figcaption>Home: workload evidence from a connected database</figcaption>
        </figure>
        <figure>
          <Image src={investigateShot} alt="Investigate page, showing the regression inbox and sample problem queries" width={1440} />
          <figcaption>Investigate: start from a regression, or a pasted query</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <h2 class="section-title">Prefer a terminal? Try pqn</h2>
      <p class="section-lede">
        A smaller, separate tool that does the same core job as the app above, but lives inside
        PostgreSQL itself instead of a browser: no server to run, just a command line against
        your database.
      </p>
      <div class="pqn-layout">
        <ol class="workflow pqn-steps">
          <li>
            <span class="workflow-index">1</span>
            <div>
              <p class="workflow-label">Finds the slow ones</p>
              <p class="workflow-detail">Reads pg_stat_statements and ranks what's actually costing time on your database right now.</p>
            </div>
          </li>
          <li>
            <span class="workflow-index">2</span>
            <div>
              <p class="workflow-label">Proposes a fix</p>
              <p class="workflow-detail">The same rewrite engine as the app above: a fix proposed from the statement's own execution plan, not a guess.</p>
            </div>
          </li>
          <li>
            <span class="workflow-index">3</span>
            <div>
              <p class="workflow-label">Proves it, or says it can't</p>
              <p class="workflow-detail">Runs both versions for real and reports one of four verdicts: Proven, NotFaster, Different, or Unverified. Never a guess dressed up as a result.</p>
            </div>
          </li>
        </ol>
        <div class="term-window" aria-hidden="true">
          <div class="term-bar">
            <span class="term-dot term-dot-red"></span>
            <span class="term-dot term-dot-yellow"></span>
            <span class="term-dot term-dot-green"></span>
            <span class="term-bar-title">psql</span>
          </div>
          <pre class="term-body" id="pqn-term-body"><code id="pqn-term-code"><span class="term-prompt">$ pqn top -n 1</span>
queryid               calls  mean     statement
-7409685708004192759  3      36.6 ms  WHERE date_trunc('day', created_at)…

<span class="term-prompt">$ pqn investigate --queryid -7409685708004192759 --bind day --bind 2025-03-01</span>
Proposed from the plan
  1. function_wrap (confidence high)
     unwrap DATE_TRUNC('day') equality to a sargable range

Proof (same rows, then faster)
  function_wrap  1096 rows  101.6 ms -&gt; 1.2 ms  87.0x  <span class="term-verdict">Proven</span>

Evidence is in the ledger: pqn evidence 1</code><span class="term-cursor" id="pqn-term-cursor" aria-hidden="true"></span></pre>
        </div>
      </div>
      <p class="ai-scope-note">
        Read-only by design: it only runs SELECT statements, and only against columns a database
        admin has explicitly exposed to that person. See it end to end in the{" "}
        <a href={site.docsUrl + "getting-started/pqn-extension/"} target="_blank" rel="noopener">ten-minute pqn quick start</a>.
      </p>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <h2 class="section-title">Open source</h2>
      <p class="section-lede">
        PgQueryNarrative is a public, MIT-licensed project. There's no gated core, no CLA, and no paid tier —
        what's on GitHub is the whole product.
      </p>
      <div class="oss-grid">
        <div class="oss-box">
          <p class="oss-label">License</p>
          <p class="oss-value">MIT</p>
          <p class="oss-detail">
            <a href={site.licenseUrl} target="_blank" rel="noopener">Read the license</a>
          </p>
        </div>
        <div class="oss-box">
          <p class="oss-label">Source</p>
          <p class="oss-value">Public repository</p>
          <p class="oss-detail">
            Every rewrite rule, plan-finding check, and report template referenced on this page is in the
            repository, not held back.
          </p>
        </div>
        <div class="oss-box">
          <p class="oss-label">Contributing</p>
          <p class="oss-value">Issues welcome</p>
          <p class="oss-detail">
            <a href={site.issuesUrl} target="_blank" rel="noopener">Open an issue</a> for bugs, gaps, or a rewrite pattern
            you'd want supported.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-final">
      <h2>Read the code, not the pitch</h2>
      <p>The investigation loop, the rewrite rules, and the verification logic are all in the repository.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={site.githubUrl} target="_blank" rel="noopener" data-analytics="github_click">
          View on GitHub
        </a>
        <a class="btn btn-secondary" href="/get-started" data-analytics="get_started_click">Get started</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 88px 64px;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  .hero-text {
    max-width: 760px;
  }

  .hero-visual {
    display: none;
    flex-shrink: 0;
  }

  @media (min-width: 960px) {
    .hero-visual {
      display: block;
    }
  }

  .hero-mark {
    position: relative;
    cursor: pointer;
  }

  .hero-mark-icon {
    filter: drop-shadow(0 0 60px color-mix(in srgb, var(--accent) 25%, transparent));
  }

  .hero-mark:hover .hero-mark-icon {
    animation: hero-mark-spin 1.4s linear infinite;
  }

  @keyframes hero-mark-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Sits inside the ring's own hollow center (inner radius ~62px at this 280px
     render height, so a 104px icon fits with room to spare) as a fixed,
     mirror-symmetric emblem — not a child of .hero-mark-icon, so it does not
     spin with the ring on hover. */
  .hero-elephant-icon {
    position: absolute;
    top: calc(50% + 10px);
    left: calc(50% + 8px);
    margin: -46px;
  }

  .elephant-body {
    fill: var(--text);
  }

  .elephant-eye {
    fill: var(--accent-strong);
  }

  .eyebrow {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.12;
  }

  .lede {
    margin-top: 22px;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--text-dim);
    max-width: 62ch;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 11px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--text);
    color: var(--bg);
  }

  .btn-primary:hover {
    opacity: 0.88;
  }

  .btn-secondary {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .btn-ghost {
    border-color: var(--border);
    color: var(--text);
  }

  .btn-ghost:hover {
    border-color: var(--text-faint);
  }

  .section {
    padding-block: 72px;
  }

  .section-muted {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .section-title {
    font-size: 1.75rem;
  }

  .section-lede {
    margin-top: 14px;
    color: var(--text-dim);
    max-width: 68ch;
    font-size: 1.0625rem;
  }

  .workflow {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 640px;
  }

  .workflow li {
    display: flex;
    gap: 20px;
    padding-block: 18px;
    border-top: 1px solid var(--border);
  }

  .workflow li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .workflow-index {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .workflow-label {
    font-weight: 600;
  }

  .workflow-detail {
    color: var(--text-dim);
    font-size: 0.9375rem;
    margin-top: 3px;
  }

  .card-grid {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .pqn-layout {
    margin-top: 40px;
    display: grid;
    grid-template-columns: minmax(260px, 360px) 1fr;
    gap: 36px;
    align-items: start;
  }

  .pqn-steps {
    max-width: none;
  }

