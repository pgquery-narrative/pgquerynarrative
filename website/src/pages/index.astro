<script>
  // Replays the pqn terminal panel as a typing animation once it scrolls into
  // view. The static markup in the .term-body <code> is the source of truth
  // (no-JS visitors and crawlers see the final output immediately); this just
  // clears it and retypes the same content to look like a live session.
  function initPqnTerminal() {
    const codeEl = document.getElementById("pqn-term-code");
    const cursor = document.getElementById("pqn-term-cursor");
    if (!(codeEl instanceof HTMLElement) || !cursor) return;
    const code = codeEl;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, reduceMotion ? 0 : ms));

    const steps: Array<
      | { cmd: string }
      | { lines: string[] }
      | { verdict: { prefix: string; word: string } }
    > = [
      { cmd: "$ pqn top -n 1" },
      {
        lines: [
          "queryid               calls  mean     statement",
          "-7409685708004192759  3      36.6 ms  WHERE date_trunc('day', created_at)…",
          "",
        ],
      },
      { cmd: "$ pqn investigate --queryid -7409685708004192759 --bind day --bind 2025-03-01" },
      {
        lines: [
          "Proposed from the plan",
          "  1. function_wrap (confidence high)",
          "     unwrap DATE_TRUNC('day') equality to a sargable range",
          "",
          "Proof (same rows, then faster)",
        ],
      },
      { verdict: { prefix: "  function_wrap  1096 rows  101.6 ms -> 1.2 ms  87.0x  ", word: "Proven" } },
      { lines: ["", "Evidence is in the ledger: pqn evidence 1"] },
    ];

    async function typeCommand(text: string) {
      const span = document.createElement("span");
      span.className = "term-prompt";
      code.appendChild(span);
      if (reduceMotion) {
        span.textContent = text;
      } else {
        for (const ch of text) {
          span.textContent += ch;
          await wait(14);
        }
      }
      code.appendChild(document.createTextNode("\n"));
      await wait(350);
    }

    async function appendLines(lines: string[]) {
      for (const line of lines) {
        code.appendChild(document.createTextNode(line + "\n"));
        await wait(55);
      }
    }

    async function appendVerdict(prefix: string, word: string) {
      code.appendChild(document.createTextNode(prefix));
      const span = document.createElement("span");
      span.className = "term-verdict";
      span.textContent = word;
      code.appendChild(span);
      code.appendChild(document.createTextNode("\n"));
      await wait(60);
    }

    async function run() {
      code.textContent = "";
      for (const step of steps) {
        if ("cmd" in step) await typeCommand(step.cmd);
        else if ("lines" in step) await appendLines(step.lines);
        else await appendVerdict(step.verdict.prefix, step.verdict.word);
      }
    }

    run();
  }

  const termWindow = document.querySelector(".term-window");
  if (termWindow) {
    let started = false;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !started) {
            started = true;
            initPqnTerminal();
            observer.disconnect();
          }
        }
      },
      { threshold: 0.35 },
    );
    observer.observe(termWindow);
  }
</script>
